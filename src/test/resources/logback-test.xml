<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Keep the test output readable: only warnings and above from the framework. -->
    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
